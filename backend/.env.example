DATABASE_URL=postgresql://amirl:amirl-local-2026@127.0.0.1:5433/amirl
FRONTEND_ORIGINS=http://localhost:3000
PUBLIC_SITE_URL=http://localhost:3000
PUBLIC_SITE_EMAIL=admin@example.test
PORT=3001
SESSION_COOKIE_NAME=amirl_session
SESSION_DAYS=30
PASSWORD_RESET_MINUTES=10
UPLOAD_ROOT=./storage
# Set STORAGE_PROVIDER=s3 for an S3-compatible bucket on ephemeral hosts.
STORAGE_PROVIDER=local
# STORAGE_BUCKET=
# STORAGE_ENDPOINT=
# STORAGE_REGION=auto
# STORAGE_ACCESS_KEY_ID=
# STORAGE_SECRET_ACCESS_KEY=
# STORAGE_FORCE_PATH_STYLE=false
ADMIN_EMAIL=replace-with-admin-email@example.com
ADMIN_NAME=AMIRLab Administrator
ADMIN_PASSWORD=REPLACE_WITH_A_LONG_RANDOM_PASSWORD

# SMTP mail delivery (any SMTP provider)
SMTP_FROM="Application <noreply@example.test>"
SMTP_HOST=smtp.example.test
SMTP_PORT=2525
SMTP_USER=replace-with-smtp-username
SMTP_PASSWORD=replace-with-smtp-password
SMTP_SECURE=false
SMTP_REQUIRE_TLS=true

# Generate once with pnpm run push:configure. Keep the private key backend-only.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=
