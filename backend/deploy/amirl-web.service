[Unit]
Description=AMIR Lab web application
After=network-online.target amirl-api.service
Wants=network-online.target

[Service]
Type=simple
User=amirl
Group=amirl
WorkingDirectory=/opt/amirl/frontend
EnvironmentFile=-/etc/amirl/web.env
Environment=NODE_ENV=production
Environment=PORT=3000
Environment=NEXT_TELEMETRY_DISABLED=1
Environment=PATH=/usr/local/bin:/usr/bin:/bin:/home/amirl/.local/bin
ExecStartPre=/usr/bin/env node --experimental-strip-types scripts/prepare-public-cache.mjs
ExecStart=/usr/bin/env pnpm start
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/amirl/frontend/.next/cache

[Install]
WantedBy=multi-user.target
