# Copy to /etc/amirl/api.env and replace every placeholder.
# Keep the populated file owned by root, group-readable by amirl (0640).
# Do not commit the populated file.
NODE_ENV=production
DATABASE_URL=postgresql://amirl:REPLACE_WITH_DATABASE_PASSWORD@127.0.0.1:5432/amirl
FRONTEND_ORIGINS=REPLACE_WITH_FRONTEND_ORIGINS
PUBLIC_SITE_URL=REPLACE_WITH_PUBLIC_SITE_URL
PUBLIC_SITE_EMAIL=REPLACE_WITH_PUBLIC_SITE_EMAIL
PORT=3001
SESSION_COOKIE_NAME=amirl_session
SESSION_DAYS=30
PASSWORD_RESET_MINUTES=10
UPLOAD_ROOT=/var/lib/amirl/uploads
STORAGE_PROVIDER=local

# Any authenticated SMTP provider.
SMTP_FROM=REPLACE_WITH_SMTP_FROM
SMTP_HOST=REPLACE_WITH_SMTP_HOST
SMTP_PORT=REPLACE_WITH_SMTP_PORT
SMTP_USER=REPLACE_WITH_SMTP_USERNAME
SMTP_PASSWORD=REPLACE_WITH_SMTP_PASSWORD
SMTP_SECURE=false
SMTP_REQUIRE_TLS=true

# Used only by the one-time empty-database seed. Never use a sample password.
ADMIN_EMAIL=REPLACE_WITH_ADMIN_EMAIL
ADMIN_NAME=REPLACE_WITH_ADMIN_NAME
ADMIN_PASSWORD=REPLACE_WITH_A_LONG_RANDOM_ADMIN_PASSWORD

# Optional: enables presence persistence for collaboration features.
# REDIS_URL=redis://127.0.0.1:6379

# Optional web-push configuration.
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:REPLACE_WITH_PUSH_CONTACT_EMAIL

# VPS-only public cache invalidation. Both values must be set together.
PUBLIC_CACHE_REVALIDATION_URL=
PUBLIC_CACHE_REVALIDATION_SECRET=
