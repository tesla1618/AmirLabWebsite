{
  "name": "api",
  "packageManager": "pnpm@10.34.5",
  "version": "0.0.1",
  "description": "",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "postinstall": "prisma generate",
    "build": "prisma generate && nest build",
    "format": "prettier --write \"src/**/*.ts\" \"scripts/**/*.{ts,mjs}\" \"test/**/*.ts\"",
    "start": "nest start",
    "dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/src/main",
    "lint": "eslint \"{src,test,scripts}/**/*.ts\"",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "jest --config ./test/jest-e2e.json",
    "admin:create": "tsx scripts/create-admin.ts",
    "push:configure": "node scripts/configure-push.mjs",
    "db:start": "node scripts/local-postgres.mjs start",
    "db:stop": "node scripts/local-postgres.mjs stop",
    "db:status": "node scripts/local-postgres.mjs status",
    "db:cluster:reset": "node scripts/local-postgres.mjs reset",
    "db:reset": "pnpm run db:rebuild",
    "db:generate": "prisma generate",
    "db:push": "node scripts/migrate-profile-entry-labels.mjs && node scripts/migrate-single-email.mjs && prisma db push && node scripts/migrate-research-system-accounts.mjs && prisma generate",
    "seed:validate": "tsx scripts/validate-seed-data.ts",
    "db:seed": "tsx scripts/rebuild-db.ts",
    "db:seed:if-empty": "tsx scripts/seed-if-empty.ts",
    "db:verify": "tsx scripts/verify-db.ts",
    "db:rebuild": "node scripts/local-postgres.mjs start && prisma generate && prisma db push --force-reset && tsx scripts/rebuild-db.ts && tsx scripts/verify-db.ts",
    "research:sources:backfill": "tsx scripts/backfill-research-sources.ts",
    "db:migrate:profile-entry-labels": "node scripts/migrate-profile-entry-labels.mjs",
    "verify:api-boundary": "node scripts/verify-api-boundary.mjs",
    "verify:recovery-research": "node scripts/verify-recovery-and-research-sync.mjs",
    "lint:fix": "eslint \"{src,test,scripts}/**/*.ts\" --fix",
    "typecheck": "prisma generate && tsc --noEmit -p tsconfig.json",
    "verify:production": "pnpm run typecheck && pnpm run lint && pnpm run verify:safety && pnpm run test --runInBand && pnpm run verify:api-boundary && pnpm run verify:recovery-research && pnpm run build",
    "verify:safety": "tsx scripts/verify-production-safety.ts",
    "test:migrations": "node --test test/research-system-accounts.migration.test.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1140.0",
    "@nestjs/common": "^12.1.0",
    "@nestjs/config": "^12.0.1",
    "@nestjs/core": "^12.1.0",
    "@nestjs/platform-express": "^12.1.0",
    "@nestjs/platform-socket.io": "^12.1.0",
    "@nestjs/swagger": "^12.0.2",
    "@nestjs/throttler": "^6.7.1",
    "@nestjs/websockets": "^12.1.0",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "cheerio": "^1.2.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "cookie-parser": "^1.4.7",
    "helmet": "^8.3.0",
    "ioredis": "^6.0.0",
    "multer": "^2.4.0",
    "nodemailer": "^10.0.10",
    "pdf-parse": "^2.4.5",
    "pdfkit": "^0.20.2",
    "pg": "^8.23.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "sharp": "^0.35.4",
    "socket.io": "^4.8.3",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.7",
    "@eslint/js": "^10.0.1",
    "@nestjs/cli": "^12.0.6",
    "@nestjs/schematics": "^12.0.5",
    "@nestjs/testing": "^12.1.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/multer": "^2.2.0",
    "@types/node": "^26.6.2",
    "@types/nodemailer": "^8.0.2",
    "@types/pdfkit": "^0.17.6",
    "@types/supertest": "^7.2.1",
    "@types/web-push": "^3.6.4",
    "dotenv": "^18.0.3",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "globals": "^17.12.0",
    "jest": "^30.5.2",
    "prettier": "^3.9.9",
    "prisma": "^7.10.0",
    "source-map-support": "^0.5.21",
    "supertest": "^7.3.0",
    "ts-jest": "^29.4.13",
    "ts-loader": "^9.6.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.1"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "moduleNameMapper": {
      "^(\\.{1,2}/.*)\\.js$": "$1"
    },
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
